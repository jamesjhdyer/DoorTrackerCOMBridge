{
  "name": "door-tracker-com-bridge",
  "productName": "Door Tracker COM Bridge",
  "version": "1.1.0",
  "description": "Desktop app for the workshop PC: NETUM NT-1228BL scanner input over a Windows COM/serial port, Zebra label printing, and the Delivery Photos local service (iPad camera -> this PC -> the company network drive, entirely on the workshop network - no cloud, no website dependency).",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "node-forge": "^1.4.0",
    "pngjs": "^7.0.0",
    "serialport": "^12.0.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "multicast-dns": "^7.2.5"
  },
  "build": {
    "appId": "com.doortracker.combridge",
    "productName": "Door Tracker COM Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "delivery-photos-web/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "delivery-photos-web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "@serialport/bindings-cpp@12.0.1": true
  }
}
